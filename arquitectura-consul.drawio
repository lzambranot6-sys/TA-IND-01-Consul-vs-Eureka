<mxfile host="app.diagrams.net">
  <diagram id="consul-arq" name="Arquitectura Consul">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Usuario externo -->
        <mxCell id="ui" value="Operador / CLI / Navegador (UI)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="10" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Datacenter -->
        <mxCell id="dc" value="Datacenter dc1" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;fontStyle=1;fontSize=14;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1020" height="780" as="geometry" />
        </mxCell>

        <!-- Servers -->
        <mxCell id="s3" value="&lt;b&gt;server3&lt;/b&gt;&lt;br&gt;(LÍDER)&lt;br&gt;Consul Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="470" y="190" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;server1&lt;/b&gt;&lt;br&gt;(follower)&lt;br&gt;Consul Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="400" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;server2&lt;/b&gt;&lt;br&gt;(follower)&lt;br&gt;Consul Server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="740" y="400" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Clients -->
        <mxCell id="c1" value="&lt;b&gt;Consul Client&lt;/b&gt;&lt;br&gt;(agente A)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="200" y="630" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Consul Client&lt;/b&gt;&lt;br&gt;(agente B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="740" y="630" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Microservicios -->
        <mxCell id="m1" value="Servicio Pagos" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="200" y="800" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Servicio Usuarios" style="shape=process;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="740" y="800" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- UI -> leader -->
        <mxCell id="e_ui" value="HTTP :8500" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="ui" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Raft entre servers -->
        <mxCell id="r31" value="Raft (RPC) :8300" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="s3" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r32" value="Raft (RPC) :8300" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="s3" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r12" value="Raft (RPC) :8300" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Gossip (punteado) -->
        <mxCell id="g1" value="Gossip :8301" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;exitX=0.25;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="c1" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="Gossip :8301" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="c2" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="Gossip :8301" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Client -> server (consultas reenviadas) -->
        <mxCell id="q1" value="HTTP/DNS reenviado&lt;br&gt;:8500 / :8600" style="endArrow=classic;html=1;strokeColor=#6c8ebf;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="c1" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="HTTP/DNS reenviado&lt;br&gt;:8500 / :8600" style="endArrow=classic;html=1;strokeColor=#6c8ebf;exitX=0.25;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="c2" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Microservicio -> client -->
        <mxCell id="reg1" value="registro + health check" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="m1" target="c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="reg2" value="registro + health check" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="m2" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Leyenda -->
        <mxCell id="ley" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Verde continua: Raft (solo servers, quórum 2 de 3)&lt;br&gt;Gris punteada: Gossip / Serf (todos los nodos)&lt;br&gt;Azul: consultas HTTP/DNS de clients a servers&lt;br&gt;Morada: registro y health checks del servicio" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="520" width="260" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
